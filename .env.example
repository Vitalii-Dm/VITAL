# VITAL backend environment

# UDP port that ESP32-S3 nodes stream CSI frames to
CSI_UDP_HOST=0.0.0.0
CSI_UDP_PORT=5005

# Backend HTTP/WebSocket
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend origin(s) allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Fusion thresholds
BREATHING_MIN_BPM=8
BREATHING_MAX_BPM=30
WETBULB_HEAT_STRESS_C=28.0
MOTION_STILL_SECONDS=5.0

# Twilio — supervisor SMS on HIGH alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SUPERVISOR_PHONE_NUMBER=

# YOLO pose worker
YOLO_MODEL=yolov8n-pose.pt
YOLO_WEBCAM_INDEX=0
YOLO_BACKEND_WS=ws://localhost:8000/ws/ingest/pose

# Frontend public config (prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_BACKEND_WS=ws://localhost:8000/ws/dashboard
NEXT_PUBLIC_BACKEND_HTTP=http://localhost:8000
